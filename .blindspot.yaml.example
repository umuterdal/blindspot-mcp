# Blindspot MCP Configuration
# Copy this file to .blindspot.yaml in your project root

# Primary language of your project
language: php  # php, javascript, typescript, python, go, rust

# Framework (enables framework-specific tools)
framework: laravel  # laravel, nextjs, django, rails, express, none

# Custom anti-pattern rules
# Each rule is checked against files matching the specified file_types
anti_patterns:
  - pattern: "console\\.log\\("
    severity: error
    message: "Remove console.log before commit"
    file_types: [js, ts, jsx, tsx]

  - pattern: "dd\\("
    severity: error
    message: "Remove dd() debug function before commit"
    file_types: [php]

  - pattern: "dump\\("
    severity: error
    message: "Remove dump() debug function before commit"
    file_types: [php]

  - pattern: "debugger"
    severity: error
    message: "Remove debugger statement before commit"
    file_types: [js, ts, jsx, tsx]

  - pattern: "TODO|FIXME|HACK|XXX"
    severity: warning
    message: "Unresolved TODO/FIXME comment"
    file_types: []  # empty = all files

  - pattern: "import pdb|breakpoint\\(\\)"
    severity: error
    message: "Remove Python debugger before commit"
    file_types: [py]

# Custom syntax checkers (overrides defaults)
# Available placeholders: {file}
syntax_check:
  php: "php -l {file}"
  typescript: "npx tsc --noEmit --pretty false {file}"
  python: "python -m py_compile {file}"
  # javascript: "node --check {file}"
  # go: "go vet {file}"
  # rust: "cargo check --message-format=short 2>&1"

# Directories to scan for specific categories
# Used by framework plugins and code intelligence
scan_dirs:
  models: "app/Models"
  controllers: "app/Http/Controllers"
  views: "resources/views"
  services: "app/Services"
  migrations: "database/migrations"
  routes: "routes"
  middleware: "app/Http/Middleware"
  tests: "tests"

# Additional directories to exclude from indexing
exclude_dirs:
  - storage
  - bootstrap/cache

# Fail-closed safety policy
# strict + allow_legacy_write=false blocks apply_edit/smart_apply_edit/apply_edit_multi
policy:
  profile: strict
  allow_legacy_write: false
  min_confidence_write: 0.70
  escalation_budget:
    per_run: 8
    per_day: 250

# Mutation + property + fuzz quality gates
quality_gates:
  enabled: true
  enforce_for_write: true
  timeout_seconds: 120
  mutation_command: "python3 -m unittest discover -s tests -p 'test_*.py' -v"
  property_command: "python3 -m unittest discover -s tests -p 'test_*.py' -v"
  fuzz_command: "python3 -m unittest discover -s tests -p 'test_*.py' -v"
  targeted_tests_enabled: true
  targeted_test_command: "python3 -m unittest -v {tests}"
  max_targeted_tests: 12

# Language adapter execution matrix (diff-aware)
language_adapters:
  hard_block_missing_tools: true
  default_matrix_always: true
  require_format_checks: false
  languages:
    python:
      parser: tree_sitter
      syntax_command: "python3 -m py_compile {files}"
      static_command: "python3 -m py_compile {files}"
      format_command: "python3 -m py_compile {files}"
      test_command: "python3 -m unittest -v"
    php:
      parser: tree_sitter
      syntax_command: "php -l {file}"
      static_command: "sh -lc \"if [ -f artisan ]; then php artisan view:cache >/dev/null && php artisan route:list >/dev/null; else php -l {file} >/dev/null; fi\""
      format_command: "php -l {file}"
      test_command: "vendor/bin/phpunit --colors=never"
      required_checks:
        syntax: true
        static: true
        format: false
        tests: false

# Auto-fix loop (bounded retries)
auto_fix_loop:
  enabled: true
  max_attempts: 2

# Deterministic runtime policy (pin mismatch => fail-closed block)
deterministic_runtime:
  require_pinned: true
  container_required: false
  pins:
    python_major: 3
    python_minor: 12

# Benchmark harness defaults
benchmark:
  sample_size_target: 2000
  seed: 42
  stratified: true

# High-speed execution controls
execution:
  profile: fast_path        # fast_path | strict_path | balanced
  runtime_budget_seconds: 1800
  precheck_parallelism: 4
  speculative_variants: 3
  warm_cache_ttl_seconds: 300
  write_quality_mode: targeted   # targeted | full
  run_full_quality_after_write: false

# KPI protocol used by release gates
kpi_protocol:
  sample_size_min: 500
  baseline_window_days: 30
  measurement_method: rolling_window
  error_budget_percent: 2.0
  drift_threshold_percent: 2.0
  allow_bootstrap_if_empty: true
  thresholds:
    gate_pass_rate_min: 95.0
    first_pass_rate_min: 90.0
    rollback_rate_max: 2.0
    critical_regressions_max: 0

# Governance defaults for approval workflows
governance:
  required_policy_approvals: 2
  required_break_glass_approvals: 2
  break_glass_default_ttl_minutes: 30
